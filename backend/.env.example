DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/personal_ai_agent
TEST_DATABASE_URL=

APP_ACCESS_TOKEN=generate-a-long-random-token
RATE_LIMIT_PER_MINUTE=120
FRONTEND_URL=http://localhost:5173

LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-llm-model
LLM_BASE_URL=https://api.example.com/v1
LLM_PROVIDER=openai-compatible
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_EMBEDDING_MODEL=
SYSTEM_PROMPT=

WEB_SEARCH_API_KEY=your-web-search-api-key
WEB_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

DEFAULT_USER_EMAIL=owner@personal-ai-agent.local
DEFAULT_USER_NAME=Owner
MAX_CONTEXT_MESSAGES=20
MEMORY_TOP_K=5
DOCUMENT_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
